# Copy to `.env` and fill from your Supabase project (Dashboard → Settings → API).
# LEAVE BLANK to run the fully-offline demo (local simulation, no auth/backend).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# From `eas init` — needed for Expo push notifications on a standalone build.
EXPO_PUBLIC_EAS_PROJECT_ID=
