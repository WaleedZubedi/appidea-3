{
  "expo": {
    "name": "Bixi",
    "slug": "bixi",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bixi",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f6f2ea",
    "ios": {
      "bundleIdentifier": "world.bixi.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:bixi.world"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "world.bixi.app",
      "adaptiveIcon": {
        "backgroundColor": "#f6f2ea",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bixi.world",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#140800",
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "dark": {
            "backgroundColor": "#140800",
            "image": "./assets/images/splash.png",
            "resizeMode": "cover"
          }
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fee04748-6dad-49aa-9fe1-00ae33d2a9a1"
      }
    },
    "owner": "wzubedi"
  }
}
