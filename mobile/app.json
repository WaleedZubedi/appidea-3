{
  "expo": {
    "name": "Bixi",
    "slug": "bixi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bixi",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f6f2ea",
    "ios": {
      "bundleIdentifier": "pet.bixi.app",
      "supportsTablet": true,
      "icon": "./assets/expo.icon",
      "associatedDomains": [
        "applinks:bixi.pet"
      ]
    },
    "android": {
      "package": "pet.bixi.app",
      "adaptiveIcon": {
        "backgroundColor": "#f6f2ea",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bixi.pet",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f2ea",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    }
  }
}
